# Copy to .env.local (git-ignored). Read by the web app (next.config.ts) and by the db scripts.

# Postgres connection string. Hosted: the pooled string from the Neon dashboard.
# Local: run `npm run db:local:start` and use the URL it prints.
DATABASE_URL=postgres://postgres@localhost:5433/instantphotos

# Signs and encrypts sessions. REQUIRED in production. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=generate-a-long-random-string

# Public URL of the site, e.g. https://instantphotos.example. Optional in development.
# BETTER_AUTH_URL=

# Super Admin accounts (ADMIN2_* is optional, for a second admin). Used by `npm run db:seed` and `npm run db:create-admin` only (the password is stored hashed in the database).
ADMIN_EMAIL=admin@instantphotos.local
ADMIN_PASSWORD=change-this-password
ADMIN_DISPLAY_NAME=Your Name
# ADMIN2_EMAIL=second.admin@instantphotos.local
# ADMIN2_PASSWORD=use-a-long-random-password
# ADMIN2_DISPLAY_NAME=Second Admin

# Optional, development only: every seeded photographer gets this password (so you can try /dashboard).
# SEED_PHOTOGRAPHER_PASSWORD=pick-a-dev-password

# Public site URL used in QR codes ({APP_URL}/e/{code}). Defaults to BETTER_AUTH_URL.
# APP_URL=https://instantphotos.example

# Cloudflare R2 (photo storage). Without these, development stores files in .local/storage; production requires them.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=instantphotos
